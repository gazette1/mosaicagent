{
  "providers": {
    "openai": {
      "baseUrl": "https://api.openai.com/v1",
      "keyEnv": "OPENAI_API_KEY"
    },
    "moonshot": {
      "baseUrl": "https://api.moonshot.ai/v1",
      "keyEnv": "MOONSHOT_API_KEY"
    },
    "deepseek": {
      "baseUrl": "https://api.deepseek.com",
      "keyEnv": "DEEPSEEK_API_KEY"
    },
    "anthropic": {
      "baseUrl": "https://api.anthropic.com/v1",
      "keyEnv": "ANTHROPIC_API_KEY_JUDGE",
      "style": "anthropic"
    },
    "gemini": {
      "baseUrl": "https://generativelanguage.googleapis.com/v1beta/openai",
      "keyEnv": "GEMINI_API_KEY"
    }
  },
  "routing": {
    "extraction": "openai:gpt-5.4-nano",
    "judge": "anthropic:claude-sonnet-5",
    "narrative": "moonshot:kimi-k3",
    "escalation": "moonshot:kimi-k3",
    "architect": "moonshot:kimi-k3",
    "shadow": "deepseek:deepseek-v4-pro"
  },
  "estPricePer1M": {
    "gpt-5.4-nano": {
      "input": 0.05,
      "output": 0.4
    },
    "gpt-5.4-mini": {
      "input": 0.25,
      "output": 2.0
    },
    "gpt-5.5": {
      "input": 2.0,
      "output": 16.0
    },
    "kimi-k3": {
      "input": 0.8,
      "output": 3.0
    },
    "deepseek-v4-pro": {
      "input": 0.28,
      "output": 1.1
    },
    "deepseek-v4-flash": {
      "input": 0.07,
      "output": 0.3
    },
    "claude-sonnet-5": {
      "input": 3.0,
      "output": 15.0
    },
    "gemini-2.5-flash": {
      "input": 0.1,
      "output": 0.4
    }
  },
  "notes": "Routing by price and independence. Extraction on nano (cheap, high volume). Generation on Kimi K3. JUDGE runs on Anthropic deliberately: a judge sharing a vendor with the generator inherits its blind spots. Shadow tier on DeepSeek for cross-provider comparison. Prices are ESTIMATES; verify before quoting."
}
